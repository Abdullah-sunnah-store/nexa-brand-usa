<footer class="nb-footer-custom">
  <div class="nb-footer-custom__accent" aria-hidden="true"></div>

  <div class="nb-footer-custom__top">
    <div class="nb-footer-custom__crest">
      <div class="nb-footer-custom__logo">
        <span class="nb-footer-custom__logo-mark">NB</span>
        <span class="nb-footer-custom__logo-text">NexaBrand <em>USA™</em></span>
      </div>
      <p class="nb-footer-custom__tagline">Elevating Everyday Living.</p>
      <p class="nb-footer-custom__pitch">Next-generation consumer brands across beauty, wellness, lifestyle, and home.</p>
      <div class="nb-footer-custom__social">
        {% if settings.social_facebook != blank %}
          <a href="{{ settings.social_facebook }}" class="nb-footer-custom__social-icon" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.99 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.493-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.128 22 16.99 22 12z"/></svg>
          </a>
        {% endif %}
        {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" class="nb-footer-custom__social-icon" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2.2c3.2 0 3.584.012 4.85.07 1.366.062 2.633.336 3.608 1.311.975.975 1.249 2.242 1.311 3.608.058 1.266.07 1.65.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.336 2.633-1.311 3.608-.975.975-2.242 1.249-3.608 1.311-1.266.058-1.65.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.336-3.608-1.311-.975-.975-1.249-2.242-1.311-3.608C2.212 15.584 2.2 15.2 2.2 12s.012-3.584.07-4.85c.062-1.366.336-2.633 1.311-3.608.975-.975 2.242-1.249 3.608-1.311C8.416 2.212 8.8 2.2 12 2.2zm0 4.865A4.935 4.935 0 0 1 16.935 12 4.935 4.935 0 0 1 12 16.935 4.935 4.935 0 0 1 7.065 12 4.935 4.935 0 0 1 12 7.065zm0 8.137A3.202 3.202 0 1 0 12 8.798a3.202 3.202 0 0 0 0 6.404zm6.291-8.336a1.152 1.152 0 1 1-2.304 0 1.152 1.152 0 0 1 2.304 0z"/></svg>
          </a>
        {% endif %}
        {% if settings.social_tiktok != blank %}
          <a href="{{ settings.social_tiktok }}" class="nb-footer-custom__social-icon" target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.86a8.16 8.16 0 0 0 4.77 1.52V6.97a4.85 4.85 0 0 1-1.84-.28z"/></svg>
          </a>
        {% endif %}
        {% if settings.social_youtube != blank %}
          <a href="{{ settings.social_youtube }}" class="nb-footer-custom__social-icon" target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1 31.3 31.3 0 0 0 .5-5.8 31.3 31.3 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="nb-footer-custom__col">
      <div class="nb-footer-custom__nav-title">Navigate</div>
      <a href="/" class="nb-footer-custom__nav-link">Home</a>
      <a href="/pages/nexabeauty" class="nb-footer-custom__nav-link">NexaBeauty™</a>
      <a href="/collections/all" class="nb-footer-custom__nav-link">Shop</a>
      <a href="/pages/wholesale" class="nb-footer-custom__nav-link">Wholesale</a>
      <a href="/pages/contact" class="nb-footer-custom__nav-link">Contact</a>
    </div>

    <div class="nb-footer-custom__col">
      <div class="nb-footer-custom__nav-title">Policies</div>
      <a href="/pages/shipping" class="nb-footer-custom__nav-link">Shipping Policy</a>
      <a href="/pages/returns" class="nb-footer-custom__nav-link">Return Policy</a>
      <a href="/policies/privacy-policy" class="nb-footer-custom__nav-link">Privacy Policy</a>
      <a href="/pages/terms-of-service" class="nb-footer-custom__nav-link">Terms of Service</a>
    </div>

    <div class="nb-footer-custom__col">
      <div class="nb-footer-custom__nav-title">Contact</div>
      <a href="mailto:info@nexabrandusa.com" class="nb-footer-custom__nav-link">info@nexabrandusa.com</a>
      <a href="mailto:sales@nexabrandusa.com" class="nb-footer-custom__nav-link">sales@nexabrandusa.com</a>
      <a href="mailto:support@nexabrandusa.com" class="nb-footer-custom__nav-link">support@nexabrandusa.com</a>
      <div class="nb-footer-custom__address">Saint Ann, MO 63074<br>United States</div>
    </div>
  </div>

  <div class="nb-footer-custom__rule" aria-hidden="true">
    <span class="nb-footer-custom__rule-dot"></span>
  </div>

  <div class="nb-footer-custom__bottom">
    <div class="nb-footer-custom__copy">
      &copy; {{ 'now' | date: '%Y' }} NexaBrand USA™. All rights reserved.<br>
      <span class="nb-footer-custom__copy-fine">NexaBeauty™ is a brand of NexaBrand USA™ · NexaBrand USA LLC · Saint Ann, MO 63074, USA</span>
    </div>
    <div class="nb-footer-custom__coming-soon">
      <span class="nb-footer-custom__cs-pulse"></span>
      Wellness · Lifestyle &amp; Accessories · Home &amp; Kitchen &mdash; Coming Soon
    </div>
  </div>
</footer>

{% stylesheet %}
  .nb-footer-custom {
    position: relative;
    background:
      radial-gradient(circle at 80% 0%, rgba(74,172,191,0.18), transparent 50%),
      radial-gradient(circle at 0% 100%, rgba(141,211,227,0.10), transparent 55%),
      linear-gradient(180deg, #0E2F36 0%, #1A3A42 100%);
    color: #B9E8F5;
    padding: 70px 24px 24px;
    font-family: 'Inter', system-ui, sans-serif;
    overflow: hidden;
  }
  .nb-footer-custom__accent {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #4AACBF, #8DD3E3, #4AACBF);
  }

  .nb-footer-custom__top {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1.2fr;
    gap: 50px;
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .nb-footer-custom__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .nb-footer-custom__logo-mark {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, #4AACBF, #8DD3E3);
    color: #0E2F36;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    letter-spacing: -0.02em;
    box-shadow: 0 6px 18px rgba(74,172,191,0.35);
  }
  .nb-footer-custom__logo-text {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 20px;
    color: #FFFFFF;
    font-weight: 700;
    letter-spacing: -0.005em;
  }
  .nb-footer-custom__logo-text em {
    color: #4AACBF;
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.08em;
    margin-left: 4px;
    font-weight: 600;
    vertical-align: middle;
  }
  .nb-footer-custom__tagline {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 14px;
    color: #8DD3E3;
    margin: 0 0 10px;
  }
  .nb-footer-custom__pitch {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(185,232,245,0.7);
    margin: 0 0 20px;
    max-width: 320px;
  }
  .nb-footer-custom__social {
    display: flex;
    gap: 10px;
  }
  .nb-footer-custom__social-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(74,172,191,0.4);
    background: rgba(74,172,191,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4AACBF;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .nb-footer-custom__social-icon:hover {
    background: linear-gradient(135deg, #4AACBF, #2F8FA3);
    color: #FFFFFF;
    transform: translateY(-2px);
    border-color: transparent;
    box-shadow: 0 8px 18px rgba(74,172,191,0.3);
  }

  .nb-footer-custom__nav-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #4AACBF;
    margin-bottom: 18px;
    position: relative;
    padding-bottom: 10px;
  }
  .nb-footer-custom__nav-title::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 24px; height: 2px;
    background: linear-gradient(90deg, #4AACBF, transparent);
    border-radius: 2px;
  }
  .nb-footer-custom__nav-link {
    display: block;
    font-size: 13px;
    color: rgba(185,232,245,0.85);
    text-decoration: none;
    margin-bottom: 10px;
    transition: color 0.25s, transform 0.25s;
    line-height: 1.55;
    width: fit-content;
  }
  .nb-footer-custom__nav-link:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }
  .nb-footer-custom__address {
    font-size: 12px;
    color: rgba(185,232,245,0.55);
    margin-top: 10px;
    line-height: 1.6;
  }

  .nb-footer-custom__rule {
    max-width: 1180px;
    margin: 50px auto 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(74,172,191,0.4), transparent);
    position: relative;
  }
  .nb-footer-custom__rule-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4AACBF;
    box-shadow: 0 0 12px #4AACBF;
  }

  .nb-footer-custom__bottom {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 14px;
  }
  .nb-footer-custom__copy {
    font-size: 12px;
    color: rgba(185,232,245,0.7);
    line-height: 1.7;
  }
  .nb-footer-custom__copy-fine {
    color: rgba(74,172,191,0.7);
    font-size: 11px;
  }
  .nb-footer-custom__coming-soon {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    color: rgba(141,211,227,0.7);
    font-style: italic;
    padding: 8px 14px;
    background: rgba(74,172,191,0.08);
    border: 1px solid rgba(74,172,191,0.18);
    border-radius: 999px;
  }
  .nb-footer-custom__cs-pulse {
    width: 6px; height: 6px;
    background: #4AACBF;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(74,172,191,0.25);
    animation: nbFooterPulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes nbFooterPulse {
    0%,100% { box-shadow: 0 0 0 3px rgba(74,172,191,0.25); }
    50% { box-shadow: 0 0 0 6px rgba(74,172,191,0.05); }
  }

  @media (max-width: 880px) {
    .nb-footer-custom__top {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .nb-footer-custom__crest { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .nb-footer-custom { padding: 56px 18px 20px; }
    .nb-footer-custom__top { grid-template-columns: 1fr; gap: 32px; }
    .nb-footer-custom__bottom { flex-direction: column; gap: 12px; }
  }
{% endstylesheet %}

