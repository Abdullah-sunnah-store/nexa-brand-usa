<section class="nb-wholesale">
  <div class="nb-wholesale__hero">
    <span class="nb-wholesale__hero-badge">WHOLESALE & DISTRIBUTION</span>
    <h1 class="nb-wholesale__hero-title">Wholesale Partnerships</h1>
    <p class="nb-wholesale__hero-sub">Retailers, distributors, spas, and boutiques — we want to work with you.</p>
  </div>

  <div class="nb-wholesale__layout">
    <aside class="nb-wholesale__perks">
      <h3 class="nb-wholesale__perks-title">Why Partner With Us</h3>
      <div class="nb-wholesale__perk">
        <div class="nb-wholesale__perk-icon">01</div>
        <div>
          <div class="nb-wholesale__perk-name">Ready to Ship Inventory</div>
          <div class="nb-wholesale__perk-desc">Stock available now — no long lead times.</div>
        </div>
      </div>
      <div class="nb-wholesale__perk">
        <div class="nb-wholesale__perk-icon">02</div>
        <div>
          <div class="nb-wholesale__perk-name">GMP Certified Brand</div>
          <div class="nb-wholesale__perk-desc">Manufactured to medical-grade standards.</div>
        </div>
      </div>
      <div class="nb-wholesale__perk">
        <div class="nb-wholesale__perk-icon">03</div>
        <div>
          <div class="nb-wholesale__perk-name">Direct Support Team</div>
          <div class="nb-wholesale__perk-desc">Talk to humans, not ticket queues.</div>
        </div>
      </div>
      <div class="nb-wholesale__perk">
        <div class="nb-wholesale__perk-icon">04</div>
        <div>
          <div class="nb-wholesale__perk-name">Flexible Partner Options</div>
          <div class="nb-wholesale__perk-desc">Custom terms for boutiques to chains.</div>
        </div>
      </div>
    </aside>

    <div class="nb-wholesale__form-wrap">
      <h2 class="nb-wholesale__form-title">Wholesale Inquiry</h2>
      <p class="nb-wholesale__form-sub">Fill out the form below or email us directly at <a href="mailto:sales@nexabrandusa.com" class="nb-wholesale__email">sales@nexabrandusa.com</a></p>

      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p class="nb-wholesale__success">Thank you — we will be in touch within 1–2 business days.</p>
        {% endif %}
        {% if form.errors %}
          <p class="nb-wholesale__error">{{ form.errors | default_errors }}</p>
        {% endif %}

        <div class="nb-wholesale__row">
          <div class="nb-wholesale__field">
            <label class="nb-wholesale__label" for="ContactFormBusinessName">Business Name *</label>
            <input type="text" id="ContactFormBusinessName" name="contact[business_name]" class="nb-wholesale__input" required>
          </div>
          <div class="nb-wholesale__field">
            <label class="nb-wholesale__label" for="ContactFormName">Contact Name *</label>
            <input type="text" id="ContactFormName" name="contact[name]" class="nb-wholesale__input" required>
          </div>
        </div>
        <div class="nb-wholesale__row">
          <div class="nb-wholesale__field">
            <label class="nb-wholesale__label" for="ContactFormEmail">Email *</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" class="nb-wholesale__input" required>
          </div>
          <div class="nb-wholesale__field">
            <label class="nb-wholesale__label" for="ContactFormPhone">Phone</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" class="nb-wholesale__input">
          </div>
        </div>
        <div class="nb-wholesale__field">
          <label class="nb-wholesale__label" for="ContactFormWebsite">Business Website</label>
          <input type="url" id="ContactFormWebsite" name="contact[website]" class="nb-wholesale__input">
        </div>
        <div class="nb-wholesale__field">
          <label class="nb-wholesale__label" for="ContactFormProducts">Products of Interest</label>
          <input type="text" id="ContactFormProducts" name="contact[products]" class="nb-wholesale__input" placeholder="e.g. HydroClear patches, Snow Mushroom masks">
        </div>
        <div class="nb-wholesale__field">
          <label class="nb-wholesale__label" for="ContactFormMessage">Message</label>
          <textarea id="ContactFormMessage" name="contact[body]" class="nb-wholesale__input nb-wholesale__textarea"></textarea>
        </div>
        <button type="submit" class="nb-wholesale__submit">Submit Inquiry &rarr;</button>
        <p class="nb-wholesale__fineprint">
          Or email us directly: <a href="mailto:sales@nexabrandusa.com" class="nb-wholesale__email">sales@nexabrandusa.com</a>
        </p>
      {% endform %}
    </div>
  </div>
</section>

{% stylesheet %}
  .nb-wholesale {
    font-family: 'Inter', system-ui, sans-serif;
    background: linear-gradient(180deg, #F7F3EC 0%, #FBF8F2 100%);
    padding: 0 0 90px;
  }
  .nb-wholesale__hero {
    background: linear-gradient(135deg, #0E2F36 0%, #1A3A42 50%, #2F8FA3 100%);
    color: #FFFFFF;
    padding: 80px 24px 70px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .nb-wholesale__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(141,211,227,0.25), transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(74,172,191,0.2), transparent 50%);
    pointer-events: none;
  }
  .nb-wholesale__hero > * { position: relative; z-index: 1; }
  .nb-wholesale__hero-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: #B9E8F5;
    padding: 7px 16px;
    border: 1px solid rgba(185,232,245,0.4);
    border-radius: 999px;
    margin-bottom: 18px;
  }
  .nb-wholesale__hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(34px, 5vw, 52px);
    margin: 0 0 14px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .nb-wholesale__hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
    max-width: 580px;
    margin: 0 auto;
  }

  .nb-wholesale__layout {
    max-width: 1100px;
    margin: -40px auto 0;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 28px;
    align-items: start;
  }

  .nb-wholesale__perks {
    background: #FFFFFF;
    border-radius: 18px;
    padding: 30px 26px;
    box-shadow: 0 14px 40px rgba(26,58,66,0.08);
    border: 1px solid rgba(26,58,66,0.05);
    position: sticky;
    top: 24px;
  }
  .nb-wholesale__perks-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 20px;
    color: #1A3A42;
    margin: 0 0 22px;
    font-weight: 700;
  }
  .nb-wholesale__perk {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px dashed rgba(26,58,66,0.1);
  }
  .nb-wholesale__perk:first-of-type { border-top: none; padding-top: 0; }
  .nb-wholesale__perk-icon {
    flex-shrink: 0;
    width: 36px; height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, #4AACBF, #2F8FA3);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0.04em;
  }
  .nb-wholesale__perk-name {
    font-size: 14px;
    font-weight: 700;
    color: #1A3A42;
    margin-bottom: 2px;
  }
  .nb-wholesale__perk-desc {
    font-size: 13px;
    color: #6B7A80;
    line-height: 1.45;
  }

  .nb-wholesale__form-wrap {
    background: #FFFFFF;
    border-radius: 18px;
    padding: 38px 36px;
    box-shadow: 0 14px 40px rgba(26,58,66,0.08);
    border: 1px solid rgba(26,58,66,0.05);
  }
  .nb-wholesale__form-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 26px;
    color: #1A3A42;
    margin: 0 0 6px;
    font-weight: 700;
  }
  .nb-wholesale__form-sub {
    font-size: 14px;
    color: #6B7A80;
    margin: 0 0 28px;
  }
  .nb-wholesale__email {
    color: #2F8FA3;
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px dotted rgba(47,143,163,0.5);
  }

  .nb-wholesale__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .nb-wholesale__field {
    margin-bottom: 16px;
  }
  .nb-wholesale__label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #1A3A42;
    margin-bottom: 6px;
    letter-spacing: 0.04em;
  }
  .nb-wholesale__input {
    width: 100%;
    padding: 13px 14px;
    background: #F0F9FB;
    border: 1.5px solid #B9E8F5;
    border-radius: 10px;
    font-size: 14px;
    color: #1F2A2E;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    font-family: inherit;
    line-height: 1.4;
  }
  .nb-wholesale__input::placeholder { color: #7B8A90; }
  .nb-wholesale__input:hover {
    border-color: #8DD3E3;
    background: #E8F6FA;
  }
  .nb-wholesale__input:focus {
    outline: none;
    border-color: #2F8FA3;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(74,172,191,0.18);
  }
  .nb-wholesale__textarea {
    min-height: 120px;
    resize: vertical;
  }
  .nb-wholesale button.nb-wholesale__submit,
  .nb-wholesale__form-wrap button.nb-wholesale__submit {
    -webkit-appearance: none !important;
    appearance: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px;
    margin-top: 14px;
    background: #1A3A42 !important;
    background-image: linear-gradient(135deg, #1A3A42 0%, #2F8FA3 100%) !important;
    color: #FFFFFF !important;
    border: none !important;
    outline: none !important;
    border-radius: 999px !important;
    padding: 15px 36px !important;
    min-height: 50px;
    font-family: 'Inter', system-ui, sans-serif !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    text-shadow: none !important;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-image 0.3s ease !important;
    box-shadow: 0 10px 26px rgba(26,58,66,0.28) !important;
    width: auto;
  }
  .nb-wholesale button.nb-wholesale__submit:hover,
  .nb-wholesale__form-wrap button.nb-wholesale__submit:hover {
    transform: translateY(-2px);
    background-image: linear-gradient(135deg, #2F8FA3 0%, #4AACBF 100%) !important;
    box-shadow: 0 14px 34px rgba(47,143,163,0.4) !important;
    color: #FFFFFF !important;
  }
  .nb-wholesale button.nb-wholesale__submit:focus-visible {
    box-shadow: 0 0 0 3px rgba(74,172,191,0.4), 0 10px 26px rgba(26,58,66,0.28) !important;
  }
  .nb-wholesale__success { color: #2e7d32; font-weight: 700; margin: 0 0 20px; padding: 12px 16px; background: #e8f5ec; border-radius: 8px; }
  .nb-wholesale__error { color: #c0392b; margin: 0 0 20px; padding: 12px 16px; background: #fdecea; border-radius: 8px; }
  .nb-wholesale__fineprint {
    font-size: 13px;
    color: #888;
    margin: 14px 0 0;
    text-align: center;
  }

  @media (max-width: 880px) {
    .nb-wholesale__layout { grid-template-columns: 1fr; gap: 20px; margin-top: -20px; }
    .nb-wholesale__perks { position: static; padding-top: 36px; }
  }
  @media (max-width: 560px) {
    .nb-wholesale { padding: 0 0 70px; }
    .nb-wholesale__hero { padding: 60px 18px 50px; }
    .nb-wholesale__layout { margin-top: -16px; padding: 0 16px; gap: 16px; }
    .nb-wholesale__perks {
      padding: 32px 20px 24px;
      border-radius: 16px;
      box-shadow: 0 10px 28px rgba(26,58,66,0.08);
    }
    .nb-wholesale__perks-title {
      font-size: 19px;
      margin: 0 0 18px;
      text-align: center;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(74,172,191,0.18);
    }
    .nb-wholesale__perk { gap: 12px; padding: 12px 0; }
    .nb-wholesale__form-wrap {
      padding: 28px 18px 28px;
      border-radius: 16px;
      box-shadow: 0 10px 28px rgba(26,58,66,0.08);
    }
    .nb-wholesale__form-title { font-size: 22px; }
    .nb-wholesale__form-sub { font-size: 13px; margin-bottom: 22px; }
    .nb-wholesale__row { grid-template-columns: 1fr; gap: 0; }
    .nb-wholesale__field { margin-bottom: 14px; }
    .nb-wholesale__label { font-size: 12px; margin-bottom: 6px; }
    .nb-wholesale__input { padding: 14px 14px; font-size: 15px; border-width: 1.5px; }
    .nb-wholesale__textarea { min-height: 110px; }
    .nb-wholesale button.nb-wholesale__submit,
    .nb-wholesale__form-wrap button.nb-wholesale__submit {
      width: 100%;
      padding: 16px 24px !important;
      font-size: 13px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NB Wholesale",
  "tag": "section",
  "settings": [],
  "presets": [{"name": "NB Wholesale", "category": "NexaBrand"}]
}
{% endschema %}
