{% comment %} ---- FAQ SECTION ---- {% endcomment %}
<div class="nb-faq">
  <h2 class="nb-faq__title">FAQ</h2>

  {% if product.tags contains 'essential' %}
    <div class="nb-faq__item">
      <div class="nb-faq__question">Is this suitable for sensitive skin?</div>
      <div class="nb-faq__answer">Yes, gentle and non-irritating. Suitable for all skin types including sensitive skin.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">When will I see results?</div>
      <div class="nb-faq__answer">Most customers notice improvement within 2–4 weeks of daily use morning and evening.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">Can I use this with other serums?</div>
      <div class="nb-faq__answer">Yes, apply before heavier creams and moisturizers in your routine.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">How many drops should I use?</div>
      <div class="nb-faq__answer">Apply 2–3 drops to cleansed skin and gently pat until fully absorbed.</div>
    </div>

  {% elsif product.tags contains 'mask' %}
    <div class="nb-faq__item">
      <div class="nb-faq__question">Can I sleep with this mask on?</div>
      <div class="nb-faq__answer">No — wear for 45–60 minutes then remove. Do not sleep with the mask on.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">How often should I use it?</div>
      <div class="nb-faq__answer">2–3 times per week for best results. Can be used daily for intensive hydration.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">What do I do with the remaining essence?</div>
      <div class="nb-faq__answer">Gently massage into skin and apply any remaining essence to your face, neck, and body. No rinsing needed.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">Does it contain collagen?</div>
      <div class="nb-faq__answer">Yes, the hydrogel is infused with Marine Collagen which helps deliver active ingredients deeper into the skin.</div>
    </div>

  {% elsif product.tags contains 'patch' %}
    <div class="nb-faq__item">
      <div class="nb-faq__question">Can I wear this under makeup?</div>
      <div class="nb-faq__answer">Yes, ultra-thin and nearly invisible under foundation.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">How long should I wear it?</div>
      <div class="nb-faq__answer">6–8 hours or remove when the patch turns white — that means it has absorbed the impurities.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">Is it safe for sensitive skin?</div>
      <div class="nb-faq__answer">Yes, gentle, breathable and non-drying for all skin types including sensitive.</div>
    </div>
    <div class="nb-faq__item">
      <div class="nb-faq__question">Is this the same formula as the 36ct?</div>
      <div class="nb-faq__answer">Yes, both the 36ct and 72ct contain the exact same formula and patch. The 72ct is simply a larger supply at a better price per patch.</div>
    </div>
  {% endif %}

</div>


{% comment %} ---- STICKY ADD TO CART BAR ---- {% endcomment %}
<div class="nb-sticky-bar" id="nbStickyBar">
  <span class="nb-sticky-bar__name">{{ product.title }}</span>
  <span class="nb-sticky-bar__price">{{ product.price | money }}</span>
  {% if product.metafields.custom.amazon_url != blank %}
    <a href="{{ product.metafields.custom.amazon_url }}" class="nb-sticky-bar__amazon" target="_blank" rel="noopener">Amazon</a>
  {% endif %}
  {% form 'product', product, id: 'nb-sticky-form' %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <button type="submit" class="nb-sticky-bar__cart">Add to Cart</button>
  {% endform %}
</div>

<script>
(function() {
  var bar = document.getElementById('nbStickyBar');
  var trigger = document.querySelector('.nb-product-hero__buttons');
  if (!bar || !trigger) return;
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      bar.classList.toggle('is-visible', !e.isIntersecting);
    });
  }, { threshold: 0 });
  obs.observe(trigger);
})();
</script>

