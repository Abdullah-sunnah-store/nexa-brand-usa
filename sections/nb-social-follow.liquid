<section class="nb-social-follow">
  <div class="nb-social-follow__inner">
    <span class="nb-social-follow__kicker">@NEXABEAUTY</span>
    <h2 class="nb-social-follow__title">Follow NexaBeauty™</h2>
    <p class="nb-social-follow__sub">Skincare tips, new products, and glow inspiration</p>

    <div class="nb-social-follow__icons">
      {% if section.settings.facebook != blank %}
