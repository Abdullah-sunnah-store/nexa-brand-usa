<section class="nb-policy nb-policy--shipping">
  <div class="nb-policy__hero">
    <span class="nb-policy__hero-badge">CUSTOMER CARE</span>
    <h1 class="nb-policy__hero-title">Shipping Policy</h1>
    <p class="nb-policy__hero-sub">Clear timelines. Tracked deliveries. No surprises.</p>
  </div>

  <div class="nb-policy__wrap">
    <div class="nb-policy__card">
      <h2 class="nb-policy__section-title">
        <span class="nb-policy__icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        </span>
        Processing Time
      </h2>
      <p class="nb-policy__body">Orders are processed within 1–2 business days after payment confirmation. Orders placed on weekends or public holidays will be processed the next business day.</p>
    </div>

    <div class="nb-policy__card">
      <h2 class="nb-policy__section-title">
        <span class="nb-policy__icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="15" height="10" rx="1"/><path d="M16 10h4l3 3v4h-7zM6 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM19 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>
        </span>
        Delivery Time
      </h2>
      <p class="nb-policy__body">Standard shipping: 5–7 business days within the United States. Expedited shipping options are available at checkout for faster delivery.</p>
    </div>

    <div class="nb-policy__card">
      <h2 class="nb-policy__section-title">
        <span class="nb-policy__icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
        </span>
        Shipping Coverage
      </h2>
      <p class="nb-policy__body">We currently ship within the United States. International shipping will be available in a future update.</p>
    </div>

    <div class="nb-policy__card">
      <h2 class="nb-policy__section-title">
        <span class="nb-policy__icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-7-7-13a7 7 0 0 1 14 0c0 6-7 13-7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
        </span>
        Order Tracking
      </h2>
      <p class="nb-policy__body">A tracking number will be emailed to you once your order has shipped. You can use this number to track your shipment through the carrier website.</p>
    </div>

    <div class="nb-policy__card">
      <h2 class="nb-policy__section-title">
        <span class="nb-policy__icon">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </span>
        Lost or Damaged Shipments
      </h2>
      <p class="nb-policy__body">If your order arrives damaged or does not arrive within the expected delivery window, please contact us at <a href="mailto:support@nexabrandusa.com" class="nb-policy__email">support@nexabrandusa.com</a> and we will resolve the issue promptly.</p>
    </div>

    <div class="nb-policy__help">
      <div class="nb-policy__help-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 4.5 1.5c-1 .8-2 1-2 2.5"/><circle cx="12" cy="17" r="0.6" fill="currentColor"/></svg>
      </div>
      <div>
        <div class="nb-policy__help-title">Have a shipping question?</div>
        <div class="nb-policy__help-sub">Email us at <a href="mailto:support@nexabrandusa.com" class="nb-policy__email">support@nexabrandusa.com</a></div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .nb-policy {
    font-family: 'Inter', system-ui, sans-serif;
    background: linear-gradient(180deg, #F0F9FB 0%, #FBF8F2 60%, #FFFFFF 100%);
    color: #1F2A2E;
    padding-bottom: 90px;
  }
  .nb-policy__hero {
    background: linear-gradient(135deg, #0E2F36 0%, #1A3A42 50%, #2F8FA3 100%);
    color: #FFFFFF;
    text-align: center;
    padding: 90px 24px 90px;
    position: relative;
    overflow: hidden;
  }
  .nb-policy__hero::before, .nb-policy__hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.4;
    pointer-events: none;
  }
  .nb-policy__hero::before { width: 320px; height: 320px; top: -100px; left: -60px; background: #4AACBF; }
  .nb-policy__hero::after { width: 280px; height: 280px; bottom: -100px; right: -50px; background: #8DD3E3; }
  .nb-policy__hero > * { position: relative; z-index: 1; }
  .nb-policy__hero-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: #B9E8F5;
    padding: 7px 16px;
    border: 1px solid rgba(185,232,245,0.4);
    border-radius: 999px;
    margin-bottom: 18px;
  }
  .nb-policy__hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(34px, 5vw, 52px);
    margin: 0 0 12px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .nb-policy__hero-sub {
    font-size: 16px;
    color: rgba(255,255,255,0.85);
    margin: 0;
    line-height: 1.6;
  }

  .nb-policy__wrap {
    max-width: 820px;
    margin: -40px auto 0;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .nb-policy__card {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 28px 30px;
    border: 1px solid rgba(74,172,191,0.18);
    box-shadow: 0 8px 28px rgba(26,58,66,0.06);
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    position: relative;
    overflow: hidden;
  }
  .nb-policy__card::before {
    content: '';
    position: absolute;
    left: 0; top: 28px; bottom: 28px;
    width: 3px;
    background: linear-gradient(180deg, #4AACBF, #8DD3E3);
    border-radius: 0 3px 3px 0;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .nb-policy__card:hover {
    transform: translateX(4px);
    border-color: rgba(74,172,191,0.4);
    box-shadow: 0 14px 36px rgba(26,58,66,0.1);
  }
  .nb-policy__card:hover::before { opacity: 1; }
  .nb-policy__section-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 19px;
    font-weight: 700;
    color: #1A3A42;
    margin: 0 0 10px;
    letter-spacing: -0.005em;
  }
  .nb-policy__icon {
    flex-shrink: 0;
    width: 36px; height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, #4AACBF, #2F8FA3);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(74,172,191,0.25);
  }
  .nb-policy__body {
    font-size: 14.5px;
    color: #4B5A60;
    line-height: 1.7;
    margin: 0;
  }
  .nb-policy__list {
    margin: 0;
    padding: 0 0 0 18px;
    font-size: 14.5px;
    color: #4B5A60;
    line-height: 1.8;
  }
  .nb-policy__list li::marker { color: #4AACBF; }
  .nb-policy__email {
    color: #2F8FA3;
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px dotted rgba(47,143,163,0.5);
  }
  .nb-policy__email:hover { color: #1A3A42; }

  .nb-policy__help {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 26px;
    background: linear-gradient(135deg, #1A3A42 0%, #2F8FA3 100%);
    color: #FFFFFF;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(26,58,66,0.18);
  }
  .nb-policy__help-icon {
    flex-shrink: 0;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(185,232,245,0.3);
  }
  .nb-policy__help-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 2px;
  }
  .nb-policy__help-sub {
    font-size: 14px;
    color: rgba(185,232,245,0.9);
  }
  .nb-policy__help .nb-policy__email { color: #B9E8F5; border-bottom-color: rgba(185,232,245,0.5); }
  .nb-policy__help .nb-policy__email:hover { color: #FFFFFF; }

  @media (max-width: 560px) {
    .nb-policy__hero { padding: 70px 16px 70px; }
    .nb-policy__wrap { padding: 0 16px; }
    .nb-policy__card { padding: 22px 20px; }
    .nb-policy__help { padding: 20px; flex-direction: column; align-items: flex-start; text-align: left; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NB Shipping Policy",
  "tag": "section",
  "settings": [],
  "presets": [{"name": "NB Shipping Policy", "category": "NexaBrand"}]
}
{% endschema %}
