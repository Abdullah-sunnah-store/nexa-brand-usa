<section class="nb-hero">
  <div class="nb-hero__bg" aria-hidden="true">
    <span class="nb-hero__orb nb-hero__orb--a"></span>
    <span class="nb-hero__orb nb-hero__orb--b"></span>
    <span class="nb-hero__orb nb-hero__orb--c"></span>
  </div>
  <div class="nb-hero__panel">
    <span class="nb-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="nb-hero__headline">{{ section.settings.headline }}</h1>
    <p class="nb-hero__subtext">{{ section.settings.subtext }}</p>
    <span class="nb-hero__tagline">{{ section.settings.tagline }}</span>
    <div class="nb-hero__buttons">
      <a href="{{ section.settings.btn1_url }}" class="nb-hero__btn-primary">{{ section.settings.btn1_text }}<span class="nb-hero__arrow">&rarr;</span></a>
      <a href="{{ section.settings.btn2_url }}" class="nb-hero__btn-secondary">{{ section.settings.btn2_text }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .nb-hero {
    position: relative;
    overflow: hidden;
    padding: 110px 20px 120px;
    background: linear-gradient(135deg, #0E2F36 0%, #1A3A42 35%, #225A6A 70%, #2F8FA3 100%);
    isolation: isolate;
    font-family: 'Inter', system-ui, sans-serif;
  }
  .nb-hero__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .nb-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    mix-blend-mode: screen;
  }
  .nb-hero__orb--a { width: 420px; height: 420px; top: -100px; left: -80px; background: #8DD3E3; animation: nbHeroDrift 14s ease-in-out infinite alternate; }
  .nb-hero__orb--b { width: 340px; height: 340px; bottom: -120px; right: -60px; background: #4AACBF; animation: nbHeroDrift 18s ease-in-out infinite alternate-reverse; }
  .nb-hero__orb--c { width: 260px; height: 260px; top: 30%; right: 25%; background: #B9E8F5; opacity: 0.3; animation: nbHeroDrift 22s ease-in-out infinite; }
  @keyframes nbHeroDrift {
    0% { transform: translate(0,0) scale(1); }
    100% { transform: translate(40px,-30px) scale(1.08); }
  }

  .nb-hero__panel {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.15);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 24px;
    padding: 56px 40px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.25);
  }
  .nb-hero__eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #B9E8F5;
    padding: 7px 16px;
    border: 1px solid rgba(185, 232, 245, 0.4);
    border-radius: 999px;
    margin-bottom: 22px;
  }
  .nb-hero__headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(36px, 5.5vw, 58px);
    line-height: 1.05;
    color: #FFFFFF;
    margin: 0 0 18px;
    letter-spacing: -0.015em;
    font-weight: 700;
  }
  .nb-hero__subtext {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
    max-width: 560px;
    margin: 0 auto 18px;
  }
  .nb-hero__tagline {
    display: inline-block;
    font-style: italic;
    font-size: 15px;
    color: #8DD3E3;
    letter-spacing: 0.04em;
    margin-bottom: 30px;
  }
  .nb-hero__buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .nb-hero__btn-primary, .nb-hero__btn-secondary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .nb-hero__btn-primary {
    background: linear-gradient(135deg, #FFFFFF 0%, #E8F6FA 100%);
    color: #1A3A42;
    box-shadow: 0 8px 22px rgba(141, 211, 227, 0.4);
  }
  .nb-hero__btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(141, 211, 227, 0.55);
  }
  .nb-hero__btn-primary .nb-hero__arrow { transition: transform 0.3s; }
  .nb-hero__btn-primary:hover .nb-hero__arrow { transform: translateX(4px); }
  .nb-hero__btn-secondary {
    background: transparent;
    color: #FFFFFF;
    border: 1.5px solid rgba(255,255,255,0.5);
  }
  .nb-hero__btn-secondary:hover {
    background: rgba(255,255,255,0.1);
    border-color: #FFFFFF;
  }
  @media (max-width: 600px) {
    .nb-hero { padding: 70px 14px 80px; }
    .nb-hero__panel { padding: 40px 22px; border-radius: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NB Hero",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NexaBrand USA™"},
    {"type": "text", "id": "headline", "label": "Headline", "default": "Elevating Everyday Living."},
    {"type": "textarea", "id": "subtext", "label": "Subtext", "default": "Next-Generation Consumer Brands inspired by innovation, science, and modern design."},
    {"type": "text", "id": "tagline", "label": "Tagline", "default": "Live Better. Shop Nexa."},
    {"type": "text", "id": "btn1_text", "label": "Primary button", "default": "Explore NexaBeauty™"},
    {"type": "url", "id": "btn1_url", "label": "Primary button link"},
    {"type": "text", "id": "btn2_text", "label": "Secondary button", "default": "Wholesale Partnerships"},
    {"type": "url", "id": "btn2_url", "label": "Secondary button link"}
  ],
  "presets": [{"name": "NB Hero", "category": "NexaBrand"}]
}
{% endschema %}
